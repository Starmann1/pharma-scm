import './style.css';

// Central REST API config
const API_BASE = "http://localhost:8080/api";

// Local state
let materials = [];
let editTargetCode = null;

// DOM Elements
const sidebarToggle = document.getElementById('sidebarToggle');
const sidebar = document.getElementById('appSidebar');
const materialsTableBody = document.getElementById('materialsTableBody');
const searchInput = document.getElementById('globalSearch');
const openAddBtn = document.getElementById('openAddMaterialBtn');
const addForm = document.getElementById('addMaterialForm');
const editForm = document.getElementById('editMaterialForm');

// XAI Elements
const xaiTrigger = document.getElementById('xaiTrigger');
const xaiPanel = document.getElementById('xaiPanel');
const xaiClose = document.getElementById('xaiClose');
const xaiPulse = document.getElementById('xaiPulse');
const tabLogs = document.getElementById('tabLogs');
const tabChat = document.getElementById('tabChat');
const viewLogs = document.getElementById('viewLogs');
const viewChat = document.getElementById('viewChat');
const chatInput = document.getElementById('chatInput');
const chatList = document.getElementById('chatList');
const sendChatBtn = document.getElementById('sendChatBtn');

/* --- SIDEBAR TOGGLE --- */
sidebarToggle.addEventListener('click', () => {
    sidebar.classList.toggle('collapsed');
    if (sidebar.classList.contains('collapsed')) {
        sidebarToggle.textContent = '▶';
        sidebarToggle.title = 'Expand Menu';
    } else {
        sidebarToggle.textContent = '◀';
        sidebarToggle.title = 'Collapse Menu';
    }
});

/* --- API CALLS --- */

// Fetch all materials
async function fetchMaterials() {
    try {
        const res = await fetch(`${API_BASE}/materials`);
        if (!res.ok) throw new Error("Failed to load materials catalog");
        materials = await res.json();
        renderMaterialsTable(materials);
    } catch (err) {
        console.error("API error fetching materials: ", err);
        showMockDataFallback();
    }
}

// Create material
async function createMaterial(material) {
    try {
        const res = await fetch(`${API_BASE}/materials`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(material)
        });
        if (!res.ok) {
            const errObj = await res.json().catch(() => ({}));
            throw new Error(errObj.error || "Failed to create material record");
        }
        closeModal('addMaterialModal');
        addForm.reset();
        await fetchMaterials();
    } catch (err) {
        alert("Error: " + err.message);
    }
}

// Update material
async function updateMaterial(code, material) {
    try {
        const res = await fetch(`${API_BASE}/materials/${code}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(material)
        });
        if (!res.ok) {
            const errObj = await res.json().catch(() => ({}));
            throw new Error(errObj.error || "Failed to update material record");
        }
        closeModal('editMaterialModal');
        await fetchMaterials();
    } catch (err) {
        alert("Error: " + err.message);
    }
}

// Delete material
async function deleteMaterial(code) {
    if (!confirm(`Are you sure you want to delete material ${code}?`)) return;
    try {
        const res = await fetch(`${API_BASE}/materials/${code}`, {
            method: 'DELETE'
        });
        if (!res.ok) {
            const errObj = await res.json().catch(() => ({}));
            throw new Error(errObj.error || "Failed to delete material record");
        }
        await fetchMaterials();
    } catch (err) {
        alert("Error: " + err.message);
    }
}

/* --- RENDER LOGIC --- */

function renderMaterialsTable(data) {
    materialsTableBody.innerHTML = '';
    if (data.length === 0) {
        materialsTableBody.innerHTML = `<tr><td colspan="9" style="text-align: center; color: var(--text-secondary);">No materials found</td></tr>`;
        return;
    }

    data.forEach(item => {
        const tr = document.createElement('tr');
        
        // Type color badge mapping
        let typeClass = 'badge-success';
        if (item.materialType === 'PACKAGING') typeClass = 'badge-warning';
        if (item.materialType === 'FINISHED_GOOD') typeClass = 'badge-success';
        if (item.materialType === 'RAW_MATERIAL') typeClass = 'badge-success';
        
        // Active badge
        const statusBadge = item.active 
            ? `<span class="badge badge-success">Active</span>` 
            : `<span class="badge badge-danger">Inactive</span>`;

        tr.innerHTML = `
            <td>${item.materialCode}</td>
            <td><strong>${item.brandName}</strong></td>
            <td>${item.genericName || '-'}</td>
            <td>${item.formulation || '-'}</td>
            <td>${item.strength || '-'}</td>
            <td><span class="badge ${typeClass}">${item.materialType}</span></td>
            <td>${item.unitOfMeasure}</td>
            <td>${statusBadge}</td>
            <td>
                <div class="action-group">
                    <button class="action-btn edit-btn" data-code="${item.materialCode}" title="Edit Material">✏️</button>
                    <button class="action-btn delete-btn" data-code="${item.materialCode}" title="Delete Material">🗑️</button>
                </div>
            </td>
        `;
        materialsTableBody.appendChild(tr);
    });

    // Attach row action listeners
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const code = e.currentTarget.getAttribute('data-code');
            launchEditModal(code);
        });
    });
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const code = e.currentTarget.getAttribute('data-code');
            deleteMaterial(code);
        });
    });
}

